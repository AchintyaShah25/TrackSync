# Copy to .env (make bootstrap does this). Never commit .env.

# --- Database ---
# Postgres connection string. Local default is the Supabase CLI stack (make db-up).
# In production: the Supabase project's pooled connection string (API) or direct one (ETL).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- API (services/api) ---
# Web origin allowed by CORS. Comma-separate multiple origins.
WEB_ORIGIN=http://localhost:3000
# Log level for the API process: debug | info | warning | error.
LOG_LEVEL=info

# --- ETL (services/etl) ---
# FastF1 on-disk cache (Jolpica + circuit info). FastF1 reads this variable natively;
# if unset it falls back to the user-wide cache, so always set it.
FASTF1_CACHE=./.cache/fastf1
# Raw OpenF1 response cache. Makes ETL re-runs and backfill resumes free; CI caches it.
OPENF1_CACHE_DIR=./.cache/openf1
# OpenF1 free tier is 30 req/min; stay under it.
OPENF1_MAX_PER_MINUTE=28

# --- Web (apps/web) ---
# Base URL of the API used by the browser and by build-time static generation.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional server-side API URL for server components (e.g. http://api:8000 in compose).
INTERNAL_API_URL=
# Set to 1 to build showcase pages from bundled fixtures instead of the API (CI builds).
SHOWCASE_FIXTURES=0

# --- Supabase CLI (local tooling) ---
# The Makefile sets these; listed here so manual CLI use stays repo-local.
SUPABASE_HOME=./.tools/supabase-home
SUPABASE_TELEMETRY_DISABLED=1
# Set to 1 during `next build` to record API responses into apps/web/fixtures/api/ for CI.
SHOWCASE_RECORD=0
