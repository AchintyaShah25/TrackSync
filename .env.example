# Copy to .env (make bootstrap does this). Never commit .env.

# --- Database ---
# Postgres connection string. Local default is the Supabase CLI stack (make db-up).
# In production (decision 0018): Supabase transaction pooler, port 6543, for the API;
# session pooler, port 5432, for the ETL and db push. The direct host is IPv6-only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- API (services/api) ---
# Web origin allowed by CORS. Comma-separate multiple origins.
WEB_ORIGIN=http://localhost:3000
# Log level for the API process: debug | info | warning | error.
LOG_LEVEL=info
# POST /strategy/simulate rate limits, per client and across all clients (decision 0023).
SIMULATE_PER_MINUTE=10
SIMULATE_GLOBAL_PER_MINUTE=120
# POST /chat limits (decision 0032). Guests are keyed by IP; per-day counts live in Postgres.
CHAT_GUEST_PER_MINUTE=5
CHAT_GUEST_PER_DAY=30
CHAT_USER_PER_MINUTE=10
CHAT_USER_PER_DAY=100
# Whole-site daily budget; keep it under the LLM providers' free daily quotas.
CHAT_GLOBAL_PER_DAY=150
# Supabase project URL and public anon key: the API validates sign-in tokens with them.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# --- ETL (services/etl) ---
# FastF1 on-disk cache (Jolpica + circuit info). FastF1 reads this variable natively;
# if unset it falls back to the user-wide cache, so always set it.
FASTF1_CACHE=./.cache/fastf1
# Raw OpenF1 response cache. Makes ETL re-runs and backfill resumes free; CI caches it.
OPENF1_CACHE_DIR=./.cache/openf1
# OpenF1 free tier is 30 req/min; stay under it.
OPENF1_MAX_PER_MINUTE=28
# Cache for knowledge-base sources (FIA PDFs, Wikipedia API responses).
RAG_CACHE_DIR=./.cache/rag/http

# --- LLM providers (API chat; ETL uses Gemini for knowledge-base embeddings) ---
# Free keys: console.groq.com and aistudio.google.com. Never commit real keys.
GROQ_API_KEY=
GEMINI_API_KEY=
# Model order for chat: "provider" (its default model below) or "provider:model".
# Providers without a key are skipped. Free quotas are per model, so several Groq models
# add up (decisions 0026, 0036).
LLM_CHAIN=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b,gemini
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash

# --- Web (apps/web) ---
# Base URL of the API used by the browser and by build-time static generation.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional server-side API URL for server components (e.g. http://api:8000 in compose).
INTERNAL_API_URL=
# Supabase Auth in the browser (public values: project URL and anon/publishable key).
# Leave empty to hide sign-in (CI, previews). Local stack: printed by `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to 1 to build showcase pages from bundled fixtures instead of the API (CI builds).
SHOWCASE_FIXTURES=0

# --- Supabase CLI (local tooling) ---
# The Makefile sets these; listed here so manual CLI use stays repo-local.
SUPABASE_HOME=./.tools/supabase-home
SUPABASE_TELEMETRY_DISABLED=1
# Turn off Next.js anonymous telemetry (set by the Makefile, web Dockerfile and CI).
NEXT_TELEMETRY_DISABLED=1
# Set to 1 during `next build` to record API responses into apps/web/fixtures/api/ for CI.
SHOWCASE_RECORD=0
